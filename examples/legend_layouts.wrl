emissiveColor IS ec
specularColor IS sc
shininess IS sh
transparency IS tr
}
}
geometry Extrusion {
spine [0 -1 0, 0 1 0]
crossSection [
1 0 0.707107 -0.707107 -1.83697e-16 -1 -0.707107 -0.707107 -1 1.22465e-16 -0.707107 0.707107 6.12323e-17 1 0.707107 0.707107 1 0
]
beginCap FALSE
endCap FALSE
creaseAngle 1.7
}
}
]
}
}
PROTO Label [
field SFVec3f p 0 0 0
field SFFloat sz 1
field MFString c []
field MFString family ["SERIF"]
field SFVec3f o 0 0 0
field SFColor dc 1 1 1
field SFColor ec 0 0 0
field SFColor sc 0.2 0.2 0.2
field SFFloat sh 0
field SFFloat tr 0
]
{
Transform {
translation IS p
children [
Billboard {
axisOfRotation 0 0 0
children [
Transform {
translation IS o
children [
Shape {
appearance Appearance {
material Material {
diffuseColor IS dc
emissiveColor IS ec
specularColor IS sc
shininess IS sh
transparency IS tr
}
}
geometry Text {
string IS c
fontStyle FontStyle {
family IS family
size IS sz
}
}
}
]
}
]
}
]
}
}
