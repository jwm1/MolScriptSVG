PROTO Ball [
exposedField SFVec3f p 0 0 0
field SFFloat rad 1.5
field SFColor dc 1 1 1
field SFColor ec 0 0 0
field SFColor sc 0.2 0.2 0.2
field SFFloat sh 0
field SFFloat tr 0
]
{
Transform {
translation IS p
children [
Shape {
appearance Appearance {
material Material {
diffuseColor IS dc
emissiveColor IS ec
specularColor IS sc
shininess IS sh
transparency IS tr
}
}
geometry Sphere {
radius IS rad
}
}
]
}
}
PROTO Cyl [
field SFBool tc TRUE
field SFBool bc TRUE
exposedField SFVec3f p 0 0 0
exposedField SFRotation r 0 0 1 0
exposedField SFVec3f s 1 1 1
field SFColor dc 1 1 1
field SFColor ec 0 0 0
field SFColor sc 0.2 0.2 0.2
field SFFloat sh 0
field SFFloat tr 0
]
{
Transform {
translation IS p
rotation IS r
scale IS s
children [
Shape {
appearance Appearance {
material Material {
diffuseColor IS dc
emissiveColor IS ec
specularColor IS sc
shininess IS sh
transparency IS tr
}
}
geometry Cylinder {
top IS tc
bottom IS bc
}
}
]
}
}
PROTO Stick [
exposedField SFVec3f p 0 0 0
exposedField SFRotation r 0 0 1 0
exposedField SFVec3f s 1 1 1
