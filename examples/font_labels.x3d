  <ProtoDeclare name="Ball">
    <ProtoInterface>
      <field accessType="inputOutput" type="SFVec3f" name="p" value="0 0 0"/>
      <field accessType="initializeOnly" type="SFFloat" name="rad" value="1.5"/>
      <field accessType="initializeOnly" type="SFColor" name="dc" value="1 1 1"/>
      <field accessType="initializeOnly" type="SFColor" name="ec" value="0 0 0"/>
      <field accessType="initializeOnly" type="SFColor" name="sc" value="0.2 0.2 0.2"/>
      <field accessType="initializeOnly" type="SFFloat" name="sh" value="0"/>
      <field accessType="initializeOnly" type="SFFloat" name="tr" value="0"/>
    </ProtoInterface>
    <ProtoBody>
      <Transform>
        <Shape>
          <Appearance>
            <Material>
              <IS>
                <connect nodeField="diffuseColor" protoField="dc"/>
                <connect nodeField="emissiveColor" protoField="ec"/>
                <connect nodeField="specularColor" protoField="sc"/>
                <connect nodeField="shininess" protoField="sh"/>
                <connect nodeField="transparency" protoField="tr"/>
              </IS>
            </Material>
          </Appearance>
          <Sphere>
            <IS>
              <connect nodeField="radius" protoField="rad"/>
            </IS>
          </Sphere>
        </Shape>
        <IS>
          <connect nodeField="translation" protoField="p"/>
        </IS>
      </Transform>
    </ProtoBody>
  </ProtoDeclare>
  <ProtoDeclare name="Cyl">
