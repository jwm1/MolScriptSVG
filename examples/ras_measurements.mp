draw fullcircle scaled 2.2 shifted (x+0.5*xpart(urcorner p+llcorner p),ypart urcorner p+1.7) withpen pencircle scaled 0.4;
x:=x+xpart(urcorner p-llcorner p);
), (167.96,337.48));
endgroup;
begingroup; save defaultfont; string defaultfont; defaultfont:="cmr10";
label("GDP", (341.67,514.58));
